{
  "name": "time-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "start": "node build/server/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^7.2.2"
  }
}
